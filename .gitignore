.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env

# Runtime data artifacts.
#
# Raw and interim frames stay out of git: they are large, and `run_pipeline.py`
# rebuilds them from the World Bank API, which is the source of truth.
#
# data/processed/ IS committed on purpose (under 1 MB). Without it a fresh clone
# has to install 15 dependencies and successfully reach the World Bank API
# before the dashboard will render anything at all.
data/raw/*.parquet
data/interim/*.parquet
logs/*.log

# Keep directory placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!logs/.gitkeep
