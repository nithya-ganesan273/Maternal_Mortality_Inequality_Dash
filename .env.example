APP_NAME=global-maternal-mortality-dashboard
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=logs

DATA_DIR=data
RAW_DATA_DIR=data/raw
INTERIM_DATA_DIR=data/interim
PROCESSED_DATA_DIR=data/processed

WORLD_BANK_API_BASE=https://api.worldbank.org/v2
WORLD_BANK_PER_PAGE=20000
WB_INDICATOR_MMR=SH.STA.MMRT
WB_INDICATOR_GDP_PC=NY.GDP.PCAP.CD
WB_INDICATOR_FEMALE_SECONDARY=SE.SEC.CUAT.LO.FE.ZS
WB_INDICATOR_FEMALE_LITERACY=SE.ADT.LITR.FE.ZS
WB_INDICATOR_HEALTH_EXPENDITURE_PC=SH.XPD.CHEX.PC.CD
WB_INDICATOR_SKILLED_BIRTH_ATTENDANCE=SH.STA.BRTC.ZS
WB_INDICATOR_URBAN_POPULATION_PCT=SP.URB.TOTL.IN.ZS

PIPELINE_START_YEAR=2000
PIPELINE_END_YEAR=2023
RANDOM_SEED=42
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRIES=3
REGRESSION_MIN_OBSERVATIONS=150
REGRESSION_OPTIONAL_PREDICTOR_MIN_COVERAGE=0.65

DASH_HOST=0.0.0.0
DASH_PORT=8050
DASH_DEBUG=false
